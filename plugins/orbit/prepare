#!/usr/bin/env bash
# Builds the orbit renderer.
#
# Run by `hyprpeach plugin add orbit`, by `hyprpeach upgrade`, and by the
# plugin's service on every start with `--if-stale`, which returns at once when
# nothing changed. Everything it makes lives outside the plugin's folder --
# the build under ~/.cache, the program under ~/.local/share -- so
# `omarchy plugin update` never meets a file it did not ship.
set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)
DATA="$HOME/.local/share/hyprpeach/orbit"
TARGET="$HOME/.cache/hyprpeach/orbit-target"

say() { printf '\033[38;5;209m🍑\033[0m %s\n' "$*"; }
die() { printf '\033[38;5;203m✗\033[0m %b\n' "$*" >&2; exit 1; }

# What the build was made from: the renderer's own files, hashed. Not a git
# revision, because the stamp has to mean the same thing in any copy.
source_stamp() {
  (cd "$HERE/renderer" && cat Cargo.toml Cargo.lock build.rs src/*.rs src/*.wgsl src/scenes/*.wgsl) | sha256sum | cut -d' ' -f1
}

ready() {
  [[ -x $DATA/hyprpeach-orbit && $(cat "$DATA/stamp" 2>/dev/null) == "$(source_stamp)" ]]
}

build() {
  command -v cargo >/dev/null || die "orbit is built from source, and there is no Rust here.\n  Install it: mise use -g rust@latest   (or: omarchy pkg add rust)"
  say "building the orbit renderer (the first build takes a few minutes)"
  cargo build --release --locked --quiet --manifest-path "$HERE/renderer/Cargo.toml" --target-dir "$TARGET"
  mkdir -p "$DATA"
  install -m 755 "$TARGET/release/hyprpeach-orbit" "$DATA/hyprpeach-orbit"
  source_stamp > "$DATA/stamp"
}

main() {
  if [[ ${1:-} == --if-stale ]] && ready; then return 0; fi
  ready || build
  # The planet scene's NASA imagery, which an earlier build fetched here. No
  # scene reads it any more; it is ours, and it is 80 MB.
  rm -rf "${DATA:?}/assets"
  say "orbit is ready"
}

main "$@"
