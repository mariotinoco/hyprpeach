#!/usr/bin/env bash
# hyprpeach — add and remove the plugins in the hyprpeach collection.
#
# hyprpeach is ONE plugin in Omarchy's registry -- an invisible service, so
# installing it puts nothing on the bar -- and this file lives in its clone:
# `omarchy plugin add` made that clone, and `omarchy plugin update` keeps it
# current. Each plugin under plugins/ is linked from Omarchy's plugins folder
# into the clone rather than copied out of it, `hyprpeach` on PATH is a link to
# this file, and the desktops library is loaded from the clone. So one Omarchy
# update moves all of it, and nothing keeps a second copy that could fall behind.
#
# WHY EVERY LINE IS INSIDE A FUNCTION. Bash reads a script as it runs it,
# keeping a byte offset into the file. `upgrade` runs `omarchy plugin update`,
# which rewrites THIS FILE underneath the running shell -- and a shell that
# then reads the next command from a changed offset runs whatever now happens
# to be there. Nothing executes until the final line, so by the time anything
# can change on disk the whole script is already parsed and in memory.
set -euo pipefail

REPOSITORY="https://github.com/mariotinoco/hyprpeach"
PLUGIN_ID="hyprpeach"
PLUGINS_DIRECTORY="$HOME/.config/omarchy/plugins"
PLUGIN_DIRECTORY="$PLUGINS_DIRECTORY/$PLUGIN_ID"
ENTRY="$HOME/.config/hypr/hyprland.lua"
COMMAND_LINK="$HOME/.local/bin/hyprpeach"
BEGIN="-- >>> hyprpeach >>>"
END="-- <<< hyprpeach <<<"
# The first comment line of the 1.x command, which install.sh COPIED onto PATH.
# A file carrying it is ours to replace with the link; any other file named
# hyprpeach is somebody else's and stays.
FIRST_GENERATION_COMMAND_MARKER="# hyprpeach — move this machine between hyprpeach releases."
# The 1.x library clone. Nothing 2.x installs reads it.
FIRST_GENERATION_CLONE="$HOME/.config/hypr/hyprpeach"
# PLUGINS THAT HAVE CHANGED NAME, old then new, oldest first. A machine that
# had one added still has it under the old name in four places after the
# update moves the folder: Omarchy's link, the bar's entry and the enabled
# list in shell.json, and the plugin's own files. `hyprpeach migrate` moves
# all four. Entries stay here for good: an install can skip releases.
RENAMED_PLUGINS=(
  "dev-ports ports"
  "animated-desktops animated"
)

# This clone, found from this file rather than assumed: `hyprpeach` on PATH is
# a link, and readlink -f follows it home.
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)

say() { printf '\033[38;5;209m🍑\033[0m %s\n' "$*"; }
# %b, not %s: these messages carry \n so a refusal can say what to do about
# itself on its own line instead of printing a literal backslash-n.
die() { printf '\033[38;5;203m✗\033[0m %b\n' "$*" >&2; exit 1; }

# EVERY COMMAND THAT CHANGES THE MACHINE RUNS FROM THE INSTALLED CLONE, and
# only from there. The links it makes point back at wherever this file is, so a
# command run from a checkout in ~/source would wire the desktop to a working
# tree that `omarchy plugin update` never touches -- and the next update would
# report success while changing nothing that runs.
require_installed_clone() {
  [[ $ROOT == "$(readlink -f "$PLUGIN_DIRECTORY" 2>/dev/null)" ]] || die \
    "this is $ROOT/bin/hyprpeach, but hyprpeach is installed at $PLUGIN_DIRECTORY.\n  Install it:  omarchy plugin add $REPOSITORY --enable\n  Then run:    $PLUGIN_DIRECTORY/bin/hyprpeach plugin list"
}

require_command() {
  local name=$1 remedy=$2
  command -v "$name" >/dev/null || die "$name not found — $remedy"
}

manifest_field() {
  local manifest=$1 field=$2
  jq -r --arg field "$field" '.[$field] // ""' "$manifest"
}

# The plugins this clone carries, by folder name: the word you type after
# `hyprpeach plugin add`.
available_plugin_names() {
  local manifest
  for manifest in "$ROOT"/plugins/*/manifest.json; do
    [[ -f $manifest ]] && basename "$(dirname "$manifest")"
  done
  return 0
}

# A PLUGIN'S OLD NAME STILL WORKS, said aloud: a script written against an
# earlier release -- `hyprpeach plugin add dev-ports` -- keeps doing what it
# did. That, with `migrate`, is what makes a rename no break at all.
current_plugin_name() {
  local name=$1 pair old new
  for pair in "${RENAMED_PLUGINS[@]}"; do
    read -r old new <<<"$pair"
    if [[ $name == "$old" ]]; then
      say "$old is now called $new" >&2
      name=$new
    fi
  done
  printf '%s\n' "$name"
}

require_plugin_name() {
  local name=$1
  [[ -n $name && -f $ROOT/plugins/$name/manifest.json ]] || die \
    "${name:+no plugin named '$name' in this release. }Which plugin?\n  Available: $(available_plugin_names | tr '\n' ' ')"
}

# Whether a plugin is on this machine, and how.
#
# `added` only when Omarchy's folder for it is a link into THIS clone. A link
# that resolves anywhere else is somebody's own arrangement -- a developer
# pointing Omarchy at a checkout -- and a real folder is a copy that no update
# will ever reach. A link that resolves nowhere is debris, usually of a clone
# that has since moved.
plugin_state() {
  local name=$1 id=$2
  local target="$PLUGINS_DIRECTORY/$id"
  if [[ -L $target && ! -e $target ]]; then
    echo "a broken link"
  elif [[ -L $target && $(readlink -f "$target") == "$ROOT/plugins/$name" ]]; then
    echo "added"
  elif [[ -L $target ]]; then
    echo "linked elsewhere"
  elif [[ -e $target ]]; then
    echo "a copy"
  else
    echo "not added"
  fi
}

# The plugins this one needs added first, from its manifest's
# `hyprpeach.requires` -- declared beside the plugin rather than known here, so
# a new plugin says what it needs without this file learning its name.
required_plugin_names() {
  local name=$1
  jq -r '.hyprpeach.requires // [] | .[]' "$ROOT/plugins/$name/manifest.json"
}

# A plugin's own setup step, declared as `hyprpeach.prepare` in its manifest:
# a script beside it that builds or fetches what the plugin needs before it can
# run. Declared rather than known here by name, like `requires`.
#
# Returns the script's status; the caller says what a failure means, because
# it means different things on `add` (nothing was added) and on `upgrade` (the
# plugin is still there, on its last build).
prepare_plugin() {
  local name=$1
  local script
  script=$(jq -r '.hyprpeach.prepare // empty' "$ROOT/plugins/$name/manifest.json")
  [[ -n $script ]] || return 0
  "$ROOT/plugins/$name/$script"
}

plugin_is_added() {
  local name=$1
  [[ $(plugin_state "$name" "$(manifest_field "$ROOT/plugins/$name/manifest.json" id)") == added ]]
}

# 🍑 a plugin you have, 🌱 one you could, ❔ one in a state `add` will explain.
command_plugin_list() {
  say "hyprpeach $(manifest_field "$ROOT/manifest.json" version) ($(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo "not a git checkout"))"
  local name
  while IFS= read -r name; do
    if [[ -z $(required_plugin_names "$name" | head -n 1) ]]; then list_plugin_tree "$name" ""; fi
  done < <(available_plugin_names)
}

# THE LIST IS A TREE OF WHAT NEEDS WHAT: each plugin under the one it
# requires, read from the same `requires` that `add` and `remove` enforce, so
# the shape on screen is the rule rather than a picture of it. A plugin that
# required two would sit under the first.
#
# `indent` is what goes before this plugin's branch: two spaces per level, and
# a bar where a sibling further down still hangs from the level above.
list_plugin_tree() {
  local name=$1 indent=$2
  local manifest="$ROOT/plugins/$name/manifest.json"
  local state mark
  state=$(plugin_state "$name" "$(manifest_field "$manifest" id)")
  case $state in
    added) mark="🍑" ;;
    "not added") mark="🌱" ;;
    *) mark="❔" ;;
  esac
  # The name column narrows by the indent, so the columns after it line up
  # at every depth. ${#indent} counts characters, one column each.
  printf '  %s%s %-*s %-8s %-10s %s\n' "$indent" "$mark" "$(( 24 - ${#indent} ))" "$name" \
    "$(manifest_field "$manifest" version)" "$state" "$(manifest_field "$manifest" name)"

  local children=() child
  while IFS= read -r child; do
    if [[ $(required_plugin_names "$child" | head -n 1) == "$name" ]]; then children+=("$child"); fi
  done < <(available_plugin_names)
  local index branch continuation
  # This plugin's own branch, as seen from its children: a "├─" above them
  # becomes "│  " beside them, a "└─" becomes blank.
  continuation=${indent//├─/│ }
  continuation=${continuation//└─/  }
  for index in "${!children[@]}"; do
    if (( index == ${#children[@]} - 1 )); then branch="└─"; else branch="├─"; fi
    list_plugin_tree "${children[$index]}" "$continuation$branch "
  done
}

# Link plugins/<name> into Omarchy's plugins folder, and enable it.
#
# A LINK, NOT A COPY, because the link is what makes the plugin follow the
# collection. `omarchy plugin update` moves this clone; a copy would stay where
# it was, and it is not a git checkout, so Omarchy's own update skips it. The
# link has nothing to fall behind. Omarchy supports linked plugins as a
# first-class case -- `omarchy plugin remove` unlinks one rather than deleting
# through it, and its catalog scans with `find -L` -- while its validator
# refuses links INSIDE a plugin, which is the other direction.
#
# Relative, so it survives a home directory that moves.
#
# Adding one that is already added is not an error and not a no-op: the link
# and the enable are left alone, and whatever the plugin writes OUTSIDE
# Omarchy is written again. For desktops that is the monitors, so adding it
# again is how a changed monitor layout is picked up.
command_plugin_add() {
  local name
  name=$(current_plugin_name "${1:-}")
  require_installed_clone
  require_command omarchy "hyprpeach plugins are Omarchy plugins"
  require_plugin_name "$name"
  local source="$ROOT/plugins/$name"
  local id
  id=$(manifest_field "$source/manifest.json" id)
  local target="$PLUGINS_DIRECTORY/$id"

  # Refused rather than added for you, so what gets added is what you typed.
  local required
  while IFS= read -r required; do
    plugin_is_added "$required" || die "$name needs $required.\n  Add it first: hyprpeach plugin add $required"
  done < <(required_plugin_names "$name")

  local state
  state=$(plugin_state "$name" "$id")
  case $state in
    "linked elsewhere")
      die "$target is a link to $(readlink "$target"), which is not this clone.\n  Remove it first: omarchy plugin remove $id"
      ;;
    "a broken link")
      rm -f "$target"
      ;;
    "a copy")
      # A folder copied out of an earlier clone, by hand or by an unreleased
      # installer. Backed up rather than deleted, the way `omarchy plugin
      # remove` treats a plugin folder that is not a git checkout -- and hidden,
      # so the shell's scan never loads the backup as a second plugin with the
      # same id.
      local backup
      backup="$PLUGINS_DIRECTORY/.$id.bak.$(date -u +%Y%m%d%H%M%S)"
      mv "$target" "$backup"
      say "moved the copy at $target to $backup"
      ;;
  esac

  # Before linking, so a plugin whose build or download fails is never on the
  # bar half-working. Also on an add of one already added: that re-checks it.
  if ! prepare_plugin "$name"; then
    [[ $state == added ]] && die "$name could not be rebuilt; it is still added, on its last build"
    die "$name could not be prepared, so it was not added"
  fi

  if [[ $state != added ]]; then
    omarchy plugin validate "$source" >/dev/null || die \
      "plugins/$name did not validate, so it was not added.\n  See why: omarchy plugin validate $source"
    mkdir -p "$PLUGINS_DIRECTORY"
    ln -s "$PLUGIN_ID/plugins/$name" "$target"

    # The running shell only knows what it has scanned, and a link made here did
    # not go through `omarchy plugin add` to trigger that scan. The scan is
    # asynchronous, so enabling straight after it can name an id the shell has
    # not read yet; `omarchy plugin add --enable` waits the same way.
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    local attempt
    for (( attempt = 0; attempt < 40; attempt++ )); do
      omarchy plugin list --json 2>/dev/null | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null && break
      sleep 0.05
    done
    # No placement: Omarchy puts it in the section its manifest names.
    omarchy plugin enable "$id" >/dev/null || die "linked $id, but Omarchy would not enable it"
  fi

  [[ $name != desktops ]] || add_desktops_to_hyprland
  add_plugin_to_hyprland "$name"
  # Here as well as in the service, because this is the first command a
  # registry install runs -- by its full path, before anything is on PATH.
  command_link_command
  if [[ $state == added ]]; then say "$id was already added"; else say "added $id"; fi
}

# Through Omarchy's own remove, which disables the plugin and then UNLINKS it.
# `rm -rf` on the link would be the same command one trailing slash away from
# deleting the folder inside this clone that it points at.
command_plugin_remove() {
  local name
  name=$(current_plugin_name "${1:-}")
  require_installed_clone
  require_command omarchy "hyprpeach plugins are Omarchy plugins"
  require_plugin_name "$name"
  local id
  id=$(manifest_field "$ROOT/plugins/$name/manifest.json" id)
  [[ $(plugin_state "$name" "$id") == added ]] || die "$id was not added by hyprpeach, so it is left alone"
  local other
  while IFS= read -r other; do
    plugin_is_added "$other" || continue
    required_plugin_names "$other" | grep -xF -- "$name" >/dev/null && die "$other needs $name.\n  Remove it first: hyprpeach plugin remove $other"
  done < <(available_plugin_names)
  [[ $name != desktops ]] || remove_desktops_from_hyprland
  remove_plugin_from_hyprland "$name"
  omarchy plugin remove "$id" --yes >/dev/null
  say "removed $id"
}

# Put `hyprpeach` on PATH, as a link to this file.
#
# The service runs this every time the shell loads it, which is how a plugin
# installed from Omarchy's registry -- where no installer of ours ever runs --
# still ends up with the command. So it has to be silent when there is nothing
# to do, and it must never take a file that is not ours.
#
# Replaces: nothing there, a link that no longer resolves, or the 1.x command,
# which was a copy and cannot follow an update. Leaves: any other file, and any
# working link, which is somebody's deliberate choice -- a developer pointing
# the command at a checkout -- that a shell loading must not quietly undo.
command_link_command() {
  require_installed_clone
  if [[ -L $COMMAND_LINK && -e $COMMAND_LINK ]]; then
    return 0
  elif [[ -f $COMMAND_LINK && ! -L $COMMAND_LINK ]]; then
    grep -qF -- "$FIRST_GENERATION_COMMAND_MARKER" "$COMMAND_LINK" || return 0
  fi
  mkdir -p "$(dirname "$COMMAND_LINK")"
  ln -sfn "$ROOT/bin/hyprpeach" "$COMMAND_LINK"
  say "hyprpeach → $COMMAND_LINK"
  case ":$PATH:" in
    *":$(dirname "$COMMAND_LINK"):"*) ;;
    *) say "note: $(dirname "$COMMAND_LINK") is not on your PATH, so 'hyprpeach' will not be found yet" ;;
  esac
}

# ---------------------------------------------------------------- desktops
#
# The one plugin that reaches outside Omarchy. Its bar strip only draws the
# desk; the desk itself is the Lua library, which Hyprland has to be told to
# load, with this machine's monitors.

# The setup() call, with YOUR monitors already filled in.
#
# Registered as `hyprpeach` in package.loaded, so any require("hyprpeach")
# elsewhere in the config gets this same copy, and a copy something else loaded
# first is used rather than joined by a second one. The library keeps its state
# in one module; two copies would each bind the keys and each keep their own
# idea of which desktop is showing.
setup_block() {
  local monitors=$1
  cat <<LUA
$BEGIN
-- Loaded from the hyprpeach plugin's clone, which \`omarchy plugin update\` keeps current.
package.loaded.hyprpeach = package.loaded.hyprpeach
  or dofile(os.getenv("HOME") .. "/.config/omarchy/plugins/$PLUGIN_ID/init.lua")
require("hyprpeach").setup({
  monitors_bottom_to_top = {
$monitors
  },
})
$END
LUA
}

require_hyprland_config() {
  local begin=$1 end=$2
  require_command hyprctl "is Hyprland installed?"
  require_command jq "install it with: omarchy pkg add jq"
  [[ -f $ENTRY ]] || die "no $ENTRY — this expects Hyprland's Lua config"
  # `grep -- "$BEGIN"`, with the end-of-options marker, because the marker
  # itself starts with `--` and grep otherwise reads it as a flag, fails, and
  # reports no match -- invisibly, in an `if`, so the block is appended again.
  # Both markers have to be there: with only the opening one the awk below
  # would treat everything after it as the block and delete the rest of the file.
  if grep -qF -- "$begin" "$ENTRY" && ! grep -qF -- "$end" "$ENTRY"; then
    die "$ENTRY has the opening marker $begin but not the closing one.\n  Repair or remove the block by hand, then run this again."
  fi
}

# Every block between `begin` and `end` in hyprland.lua replaced by
# `replacement` -- the FIRST one by it, any others dropped -- so this converges
# on at most one however many are there. An empty replacement removes the block.
# Each plugin's block has markers of its own, so one never touches another's.
replace_hyprland_block() {
  local begin=$1 end=$2 replacement=$3
  # Blank lines are held back until the next line is known: a block that is
  # removed takes the one blank line `add` put before it, so adding and
  # removing leaves the file exactly as it was, not a line longer each time.
  awk -v begin="$begin" -v end="$end" -v replacement="$replacement" '
    index($0,begin){
      if (replacement == "") held = substr(held, 2)
      printf "%s", held; held = ""
      if (!done && replacement != "") print replacement
      done=1; skipping=1; next
    }
    index($0,end){ skipping=0; next }
    skipping { next }
    $0 == "" { held = held "\n"; next }
    { printf "%s", held; held = ""; print }
    END { printf "%s", held }' "$ENTRY" > "$ENTRY.hyprpeach.tmp"
  mv "$ENTRY.hyprpeach.tmp" "$ENTRY"
}

reload_hyprland() {
  hyprctl reload >/dev/null
  local errors
  errors=$(hyprctl configerrors | tr -d '[:space:]')
  [[ -z $errors ]] || die "Hyprland reported config errors:\n$(hyprctl configerrors)"
}

add_desktops_to_hyprland() {
  require_hyprland_config "$BEGIN" "$END"
  hyprctl monitors -j >/dev/null 2>&1 || die "Hyprland is not running, so its monitors cannot be read"

  # The monitors, in physical order with the bottom one first. Sorted by y
  # descending because y grows downward, and matched by EDID description rather
  # than connector name: DP-3 and DP-5 swap when cables move ports, and two
  # monitors of one model would then quietly trade desktops.
  #
  # Then left to right, for monitors side by side at one height, which would
  # otherwise come out in whatever order Hyprland lists them. On a laptop
  # docked between two screens and centred on them, the laptop sorts first --
  # it sits lower -- and so keeps desktops 1-9, which is right: it is the
  # screen still there when the dock is not.
  local monitors
  monitors=$(hyprctl monitors -j | jq -r 'sort_by(-.y, .x) | .[] | "    \"desc:\(.description)\","')
  [[ -n $monitors ]] || die "no monitors reported"
  say "found $(wc -l <<<"$monitors") monitor(s), bottom first:"
  sed 's/^/  /' <<<"$monitors"

  if grep -qF -- "$BEGIN" "$ENTRY"; then
    # Also the 1.x migration: the block 1.x wrote loads the library from
    # ~/.config/hypr/hyprpeach, and this one loads it from the plugin.
    replace_hyprland_block "$BEGIN" "$END" "$(setup_block "$monitors")"
  else
    say "appending hyprpeach to hyprland.lua (after your defaults, which is required)"
    printf '\n%s\n' "$(setup_block "$monitors")" >> "$ENTRY"
  fi

  # Both of these are displaced rather than merely unused. `omarchy.workspaces`
  # cannot draw a hyprpeach desk at all. `omarchy.menu` is the widget sitting
  # ahead of the strip in the left section, and the strip is built to LEAD that
  # section: it reaches out to line its first tile up with the edge of a tiled
  # window, which is only the right place to be when nothing is in front of it.
  # The menu stays one keypress away on SUPER. Removing desktops puts both back.
  omarchy plugin disable omarchy.workspaces >/dev/null 2>&1 || true
  omarchy plugin disable omarchy.menu >/dev/null 2>&1 || true
  # A VERTICAL BAR, because the strip is a column of nine cells and a desk this
  # model is for is wide. This is the one setting here that is a preference
  # rather than a consequence, and it goes through Omarchy's own command rather
  # than an edit to shell.json, so `omarchy bar position top` puts it back and
  # nothing here will argue -- until desktops is added again.
  omarchy bar position left >/dev/null 2>&1 || say "note: could not move the bar to the left"

  if [[ -d $FIRST_GENERATION_CLONE/.git ]]; then
    say "note: $FIRST_GENERATION_CLONE is the 1.x library, and nothing hyprpeach installs reads it now."
    say "      Once nothing of your own requires it: rm -rf $FIRST_GENERATION_CLONE"
  fi

  reload_hyprland
  say "press SUPER+2, and the whole desk turns"
}

# The inverse, as far as it can be known. The two displaced widgets go back
# where Omarchy ships them. The bar's position does not: what it was before is
# not recorded anywhere, and guessing would move somebody's bar twice.
remove_desktops_from_hyprland() {
  require_hyprland_config "$BEGIN" "$END"
  replace_hyprland_block "$BEGIN" "$END" ""
  omarchy plugin enable omarchy.workspaces >/dev/null 2>&1 || true
  omarchy plugin enable omarchy.menu --section left >/dev/null 2>&1 || true
  reload_hyprland
  say "Hyprland's own workspace keys are back. The bar stays where it is: omarchy bar position top moves it."
}

# A PLUGIN THAT IS HYPRLAND CONFIGURATION. Some plugins are keys rather than
# anything on screen -- pin is SUPER + P -- and keys live in Hyprland's config,
# not the shell. Such a plugin names a Lua file in its manifest
# (`hyprpeach.hyprland`), and adding it puts a block in hyprland.lua that loads
# that file from this clone, so `omarchy plugin update` moves it like any other.
# Removing it takes the block out. Each has its own markers, after desktops',
# so its keys are bound last and win.
plugin_hyprland_file() {
  local name=$1
  jq -r '.hyprpeach.hyprland // empty' "$ROOT/plugins/$name/manifest.json"
}

plugin_block_markers() {
  local name=$1
  printf '%s\n%s\n' "-- >>> hyprpeach $name >>>" "-- <<< hyprpeach $name <<<"
}

# Loaded only if it is there: with hyprpeach uninstalled and the block left
# behind, Hyprland starts without the keys rather than with a config error.
plugin_block() {
  local name=$1 file=$2 begin=$3 end=$4
  cat <<LUA
$begin
-- Loaded from the hyprpeach plugin's clone, which \`omarchy plugin update\` keeps current.
do
  local file = os.getenv("HOME") .. "/.config/omarchy/plugins/$PLUGIN_ID/plugins/$name/$file"
  local readable = io.open(file, "r")
  if readable then readable:close(); dofile(file) end
end
$end
LUA
}

add_plugin_to_hyprland() {
  local name=$1
  local file begin end
  file=$(plugin_hyprland_file "$name")
  [[ -n $file ]] || return 0
  { read -r begin; read -r end; } < <(plugin_block_markers "$name")
  require_hyprland_config "$begin" "$end"
  if grep -qF -- "$begin" "$ENTRY"; then
    replace_hyprland_block "$begin" "$end" "$(plugin_block "$name" "$file" "$begin" "$end")"
  else
    printf '\n%s\n' "$(plugin_block "$name" "$file" "$begin" "$end")" >> "$ENTRY"
  fi
  reload_hyprland
}

remove_plugin_from_hyprland() {
  local name=$1
  local begin end
  [[ -n $(plugin_hyprland_file "$name") ]] || return 0
  { read -r begin; read -r end; } < <(plugin_block_markers "$name")
  require_hyprland_config "$begin" "$end"
  replace_hyprland_block "$begin" "$end" ""
  reload_hyprland
}

# ---------------------------------------------------------------- the rest

# Omarchy's update, then a Hyprland reload.
#
# The update is the whole upgrade -- every plugin added from here is a link into
# the clone it moves -- except for the desktops library. Hyprland ran init.lua
# when it loaded its config and keeps running that copy until it reloads; a new
# init.lua on disk changes nothing until then.
command_upgrade() {
  require_installed_clone
  require_command omarchy "hyprpeach is an Omarchy plugin"
  omarchy plugin update "$PLUGIN_ID"
  # This file is the one from BEFORE the update, already in memory; the
  # migration it runs is the updated one, from disk.
  "$ROOT/bin/hyprpeach" migrate
  # Reported, not fatal: the update has already happened, and the rebuilds and
  # the list below are still worth having. Errors here are usually the
  # person's own config meeting a new release, and they need to see them.
  hyprctl reload >/dev/null
  local errors
  errors=$(hyprctl configerrors)
  [[ -z $(tr -d '[:space:]' <<<"$errors") ]] || printf '\033[38;5;203m✗\033[0m Hyprland reported config errors after the update:\n%s\n' "$errors" >&2
  # An update can move a plugin's source on; its build has to follow. One that
  # fails to rebuild keeps running its last build.
  local name
  while IFS= read -r name; do
    if plugin_is_added "$name" && ! prepare_plugin "$name"; then
      printf '\033[38;5;203m✗\033[0m %s could not be rebuilt; it keeps running its last build\n' "$name" >&2
    fi
  done < <(available_plugin_names)
  command_plugin_list
}

# ANIMATED SETTINGS: the scene, and how fast a switch is. The file
# is ~/.config/hyprpeach/animated.json; what may go in it, and the
# defaults, are in the plugin's settings.schema.json, which the renderer reads
# too -- so this offers exactly the choices the renderer accepts.
#
# With no value, the choices, the one in effect marked. With one, it is
# written; the running renderer looks at the file once a second.
command_setting() {
  local key=$1 value=${2:-}
  local schema="$ROOT/plugins/animated/settings.schema.json"
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/hyprpeach/animated.json"
  local current choice
  # What the renderer is using: the file's value when the schema allows it,
  # otherwise the default -- the renderer falls back the same way.
  current=$(jq -r --arg key "$key" '.[$key] // empty' "$file" 2>/dev/null || true)
  jq -e --arg key "$key" --arg value "$current" '.properties[$key].enum | index($value)' "$schema" >/dev/null 2>&1 \
    || current=$(jq -r --arg key "$key" '.properties[$key].default' "$schema")
  if [[ -z $value ]]; then
    while IFS= read -r choice; do
      if [[ $choice == "$current" ]]; then say "$choice  (in effect)"; else printf '   %s\n' "$choice"; fi
    done < <(jq -r --arg key "$key" '.properties[$key].enum[]' "$schema")
    return
  fi
  jq -e --arg key "$key" --arg value "$value" '.properties[$key].enum | index($value)' "$schema" >/dev/null \
    || die "$key $value is not one of: $(jq -r --arg key "$key" '.properties[$key].enum | join(", ")' "$schema")"
  mkdir -p "$(dirname "$file")"
  local existing='{}'
  [[ -s $file ]] && existing=$(cat "$file")
  jq --arg key "$key" --arg value "$value" --arg schema "$schema" '. + { "$schema": $schema, ($key): $value }' <<< "$existing" > "$file.tmp" \
    || { rm -f "$file.tmp"; die "$file is not JSON; fix or delete it"; }
  mv "$file.tmp" "$file"
  say "$key: $value"
}

# A RENAMED PLUGIN, CARRIED OVER: run by hyprpeach's own service every time
# the shell loads it -- which `omarchy plugin update` makes it do -- and by
# `hyprpeach upgrade`. So the move happens whichever way the update came, and
# without anyone knowing to ask for it. Does nothing when there is nothing to
# move, which is nearly always; safe to run any number of times.
#
# Only a link of ours is moved, one pointing into this clone at the old
# folder. A copy or a link elsewhere is somebody's own, and stays.
command_migrate() {
  [[ $ROOT == "$(readlink -f "$PLUGIN_DIRECTORY" 2>/dev/null)" ]] || return 0
  local pair old new old_link new_link moved=()
  for pair in "${RENAMED_PLUGINS[@]}"; do
    read -r old new <<<"$pair"
    old_link="$PLUGINS_DIRECTORY/$PLUGIN_ID.$old"
    new_link="$PLUGINS_DIRECTORY/$PLUGIN_ID.$new"
    [[ -L $old_link && $(readlink "$old_link") == "$PLUGIN_ID/plugins/$old" ]] || continue
    rm "$old_link"
    [[ -e $new_link || -L $new_link ]] || ln -s "$PLUGIN_ID/plugins/$new" "$new_link"
    rename_in_shell_configuration "$PLUGIN_ID.$old" "$PLUGIN_ID.$new"
    move_plugin_files "$old" "$new"
    moved+=("$old → $new")
  done
  (( ${#moved[@]} )) || return 0
  # The running shell reads shell.json again and finds the new folders: the
  # widget comes back where it was, the service under its new name.
  omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  say "renamed: ${moved[*]}"
}

# The bar entry keeps its section, its place in it, and any settings of its
# own; the enabled list keeps its place. An entry already under the new id is
# dropped first -- a leftover from an earlier plugin of that name would
# otherwise come back to life beside the moved one, two widgets for one.
# Only where the old id is present: run again, this changes nothing.
rename_in_shell_configuration() {
  local old=$1 new=$2
  local file="$HOME/.config/omarchy/shell.json"
  [[ -s $file ]] || return 0
  jq --arg old "$old" --arg new "$new" '
    def entry_id: if type == "string" then . elif type == "object" then (.id // "") else "" end;
    def renamed: if type == "string" and . == $old then $new elif type == "object" and .id == $old then .id = $new else . end;
    def carried: if any(.[]; entry_id == $old) then map(select(entry_id != $new)) | map(renamed) else . end;
    ([(.bar.layout // {})[] | select(type == "array") | .[] | entry_id] | any(. == $old)) as $on_bar
    | if $on_bar then .bar.layout |= map_values(if type == "array" then map(select(entry_id != $new)) | map(renamed) else . end) else . end
    | if (.plugins | type) == "array" then .plugins |= carried else . end
  ' "$file" > "$file.tmp" && mv "$file.tmp" "$file" || rm -f "$file.tmp"
}

# A plugin's own files go by its name: its program under ~/.local/share, its
# build under ~/.cache, its settings under ~/.config. Moved, not rebuilt or
# reset: a build carried over only recompiles what changed, and settings are
# somebody's choices. Never over something already at the new name.
move_plugin_files() {
  local old=$1 new=$2
  local configuration="${XDG_CONFIG_HOME:-$HOME/.config}/hyprpeach"
  local pair from to
  for pair in \
    "$HOME/.local/share/hyprpeach/$old|$HOME/.local/share/hyprpeach/$new" \
    "$HOME/.cache/hyprpeach/$old-target|$HOME/.cache/hyprpeach/$new-target" \
    "$configuration/$old.json|$configuration/$new.json"; do
    from=${pair%%|*}
    to=${pair#*|}
    if [[ -e $from && ! -e $to ]]; then mv "$from" "$to"; fi
  done
  # The settings name their schema by path, which moved with the folder.
  local settings="$configuration/$new.json"
  if [[ -s $settings ]] && jq -e 'has("$schema")' "$settings" >/dev/null 2>&1; then
    jq --arg schema "$ROOT/plugins/$new/settings.schema.json" '."$schema" = $schema' "$settings" > "$settings.tmp" \
      && mv "$settings.tmp" "$settings" || rm -f "$settings.tmp"
  fi
  return 0
}

command_help() {
  cat <<'USAGE'
🍑 hyprpeach — Omarchy plugins for Hyprland on more than one monitor

  hyprpeach plugin list           the plugins in the collection, and which you have
  hyprpeach plugin add <name>     add one — it updates whenever hyprpeach does
  hyprpeach plugin remove <name>  take one off again
  hyprpeach upgrade               omarchy plugin update, then reload Hyprland
  hyprpeach scene [name]          animated desktops: the scenes, or show another
  hyprpeach speed [speed]         animated desktops: calm, quick or snappy switches
  hyprpeach version               the same as plugin list
  hyprpeach link-command          put `hyprpeach` on PATH (the plugin does this itself)
  hyprpeach migrate               carry a renamed plugin over (the plugin does this itself)
  hyprpeach help                  this

  Adding desktops again re-reads your monitors.
USAGE
}

main() {
  case "${1:-help}" in
    plugin)
      case "${2:-list}" in
        list) command_plugin_list ;;
        add) command_plugin_add "${3:-}" ;;
        remove) command_plugin_remove "${3:-}" ;;
        *) command_help; die "unknown plugin command: $2" ;;
      esac
      ;;
    upgrade) command_upgrade ;;
    migrate) command_migrate ;;
    scene) command_setting scene "${2:-}" ;;
    speed) command_setting speed "${2:-}" ;;
    version) command_plugin_list ;;
    link-command) command_link_command ;;
    help|-h|--help) command_help ;;
    *) command_help; die "unknown command: $1" ;;
  esac
}

main "$@"
